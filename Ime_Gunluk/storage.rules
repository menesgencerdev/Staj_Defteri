rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.role in ['admin', 'superadmin'];
    }

    function diaryDoc(diaryId) {
      return firestore.get(/databases/(default)/documents/diaries/$(diaryId));
    }

    function canAccessDiaryFiles(diaryId) {
      let d = diaryDoc(diaryId).data;
      return signedIn() && (
        isAdmin()
        || d.studentId == request.auth.uid
        || d.ownerId == request.auth.uid
        || d.creatorId == request.auth.uid
        || d.instructorId == request.auth.uid
        || d.studentEmail == request.auth.token.email
        || d.instructorEmail == request.auth.token.email
      );
    }


    match /diaries/{diaryId}/{allPaths=**} {
      allow read: if canAccessDiaryFiles(diaryId);
      allow create, update: if false; // Dosya yukleme backend Admin SDK uzerinden.
      allow delete: if false; // Dosya silme backend Admin SDK uzerinden.
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}


